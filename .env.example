# Copy to .env.local and fill in from your Supabase project:
#   Dashboard -> Project Settings -> API Keys
#
# Both of these are PUBLIC. They ship inside the built JS bundle, which anyone can read.
# That is how Supabase is designed to work — the publishable key identifies the project,
# Row Level Security decides what it can reach. See supabase/schema.sql.
#
# Never put the secret / service_role key here. It bypasses RLS entirely, and anything in
# a VITE_-prefixed variable is compiled into the public bundle.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
